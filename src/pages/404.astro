---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="text-center py-20">
    <h1 class="text-6xl font-bold text-gray-300 mb-4">404</h1>
    <p class="text-xl text-gray-600 mb-8">This page doesn't exist.</p>
    <a href="/" class="text-accent hover:text-accent-hover font-medium no-underline">
      Back to home
    </a>
  </div>
</Base>
