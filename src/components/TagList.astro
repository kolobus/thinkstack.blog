---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {tags.map((tag) => (
    <a
      href={`/tags/${tag}`}
      class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-orange-50 text-accent hover:bg-orange-100 no-underline"
    >
      {tag}
    </a>
  ))}
</div>
