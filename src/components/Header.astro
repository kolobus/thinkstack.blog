---
const navLinks = [
  { href: '/blog', label: 'Blog' },
  { href: '/tags', label: 'Tags' },
];
---

<header class="border-b border-gray-200">
  <nav class="max-w-2xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-bold text-gray-900 hover:text-accent no-underline">
      Think Stack
    </a>
    <ul class="flex gap-6 list-none m-0 p-0">
      {navLinks.map(({ href, label }) => (
        <li>
          <a href={href} class="text-gray-600 hover:text-accent no-underline font-medium">
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
