---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  publishedDate?: Date;
  tags?: string[];
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  publishedDate,
  tags,
} = Astro.props;

const isHome = title === 'Think Stack';
const pageTitle = isHome ? 'Think Stack' : `${title} | Think Stack`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = new URL(ogImage || '/og-default.png', Astro.site).href;
const gaId = import.meta.env.GA_ID;

const jsonLd =
  ogType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: resolvedOgImage,
        datePublished: publishedDate?.toISOString(),
        url: canonicalURL.href,
        author: { '@type': 'Person', name: 'kolo' },
        publisher: {
          '@type': 'Organization',
          name: 'Think Stack',
          url: Astro.site?.href,
        },
        ...(tags && { keywords: tags.join(', ') }),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Think Stack',
        url: Astro.site?.href,
        description,
      };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#f97316" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title="Think Stack" href="/rss.xml" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="Think Stack" />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
{tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />

<!-- JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

<!-- Google Analytics -->
{gaId && (
  <>
    <script is:inline define:vars={{ gaId }} src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}
